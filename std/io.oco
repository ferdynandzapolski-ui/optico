// std/io.oco - Input/Output resources for OptiCo v0.3

// C standard library file I/O declarations
extern "C" {
    void* fopen(char* path, char* mode);
    int fclose(void* file);
    int fread(void* ptr, int size, int count, void* file);
    int fwrite(void* ptr, int size, int count, void* file);
    int fseek(void* file, int offset, int whence);
    int ftell(void* file);
}

protocol File {
    state Open {
        optic int* read;
        optic int* write;
    }
    state Closed {}
}

struct FileObj {
    int fd;
}

struct Console {
    int id;
}

// Global console resource
resource Console console = alloc<Console>(1);

