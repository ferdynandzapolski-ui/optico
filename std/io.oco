}

File[Open] file_open(String path) {
    alloc<FileObj>(0)
}

void file_close(optic int*!f closer) {
    closer := 0;
}

// Read entire file content into a String
// Returns empty string on error
String read_file(String path) {
    void* file = fopen(path.data, "rb");
    if (file == 0) {
        String result;
        result.len = 0;
        result.data = 0;
        return result;
    }

    fseek(file, 0, 2);
    int size = ftell(file);
    fseek(file, 0, 0);

    if (size < 0) {
        fclose(file);
        String result;
        result.len = 0;
        result.data = 0;
        return result;
    }

    pointer<char, Normal> buf = alloc<char, Normal>(size + 1);
    if (buf == 0) {
        fclose(file);
        String result;
        result.len = 0;
        result.data = 0;
        return result;
    }

    int bytes_read = fread(buf, 1, size, file);
    fclose(file);

    if (bytes_read < 0) {
        String result;
        result.len = 0;
        result.data = 0;
        return result;
    }

    buf[bytes_read] = 0;

    String result;
    result.len = bytes_read;
    result.data = buf;
    return result;
}

// Write string content to file
// Returns 0 on success, non-zero on error
int write_file(String path, String content) {
    void* file = fopen(path.data, "wb");
    if (file == 0) {
        return -1;
    }

    if (content.len <= 0) {
        fclose(file);
        return 0;
    }

    int bytes_written = fwrite(content.data, 1, content.len, file);
    fclose(file);

    if (bytes_written == content.len) {
        return 0;
    }
    return -1;
}
