// std/io.oco - Input/Output resources for OptiCo v0.3

protocol File {
    state Open {
        optic int* read;
        optic int* write;
    }
    state Closed {}
}

struct FileObj {
    int fd;
}

struct Console {
    int id;
}

// Global console resource
resource Console console = alloc<Console>(1);

void print_int(int val) {
    // intrinsic: outputs val to console
}

void print_char(char val) {
    // intrinsic
}

char read_char() {
    // intrinsic: reads from console
    ' '
}

void write_char(char c) {
    // intrinsic: outputs char to console
}

// Example print_string
void print_string(String s) {
    // loop and print_char (simplified)
}

File[Open] file_open(String path) {
    alloc<FileObj>(0)
}

void file_close(optic int*!f closer) {
    closer := 0;
}
