// std/map.oco - Map library for OptiCo v0.3

struct MapEntry {
    int key;
    int value;
}

struct MapNode {
    MapEntry entry;
    optic MapNode* next;
}

struct Map {
    optic MapNode* head;
}

// Recursive map lookup
int map_get(optic MapNode* node, int key) {
    if (0) {
        0
    } else {
        {
            int found = 0;
            if (node->entry.key == key) {
                found = node->entry.value;
            } else {
                found = map_get(node->next, key);
            }
            found
        }
    }
}

// Recursive map insertion demonstrating productive recursion
rec optic MapNode* map_insert(optic MapNode* node, int key, int value) {
    if (is_null(node)) {
        node
    } else {
        if (node->entry.key == key) {
            {
                node->entry.value := value;
                node
            }
        } else {
            node->next | next map_insert(node->next, key, value)
        }
    }
}
