// std/map.oco - Map library for OptiCo v0.3

struct MapEntry {
    int key;
    int value;
}

struct MapNode {
    MapEntry entry;
    optic MapNode* next;
}

// Recursive map lookup
int map_get(optic MapNode* node, int key) {
    {
        // Note: Symbolic representation using Nakano's productivity guards if needed
        // but here simply following the linked list.
        node->entry.value | next map_get(node->next, key)
    }
}
