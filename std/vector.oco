// std/vector.oco - Vector library for OptiCo v0.3

extern "C" {
    pointer<int, Heap> malloc_int(int size);
    void free_int(pointer<int, Heap> ptr);
}

struct Vector {
    int size;
    int capacity;
    pointer<int, Heap> data;
}

Vector vector_new(int cap) {
    alloc<Vector>(0, cap, malloc_int(cap * 4))
}

void vector_copy_rec(pointer<int, Heap> dst, pointer<int, Heap> src, int num, int i) {
    if (i < num) {
        {
            dst[i] := src[i];
            vector_copy_rec(dst, src, num, i + 1);
        }
    } else {
        0
    }
}

void vector_push(Vector v, int val) {
    if (v.size == v.capacity) {
        {
            int new_cap = v.capacity * 2;
            if (new_cap == 0) {
                new_cap = 4;
            } else { 0 };
            pointer<int, Heap> new_data = malloc_int(new_cap * 4);
            vector_copy_rec(new_data, v.data, v.size, 0);
            v.data := new_data;
            v.capacity := new_cap;
            v.data[v.size] := val;
            v.size := v.size + 1;
        }
    } else {
        {
            v.data[v.size] := val;
            v.size := v.size + 1;
        }
    }
}

void vector_set(Vector v, int i, int val) {
    v.data[i] := val;
}

int vector_get(Vector v, int index) {
    v.data[index]
}

int vector_pop(Vector v) {
    if (v.size == 0) {
        0
    } else {
        {
            v.size := v.size - 1;
            v.data[v.size]
        }
    }
}

void vector_clear(Vector v) {
    v.size := 0;
}

bool vector_contains(Vector v, int val) {
    vector_contains_rec(v, val, 0)
}

bool vector_contains_rec(Vector v, int val, int i) {
    if (i < v.size) {
        if (v.data[i] == val) {
            true
        } else {
            vector_contains_rec(v, val, i + 1)
        }
    } else {
        false
    }
}
