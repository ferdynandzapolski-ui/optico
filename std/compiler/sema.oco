// Semantic analysis for OptiCo self-hosted compiler
// Implements symbol table management, type checking, and basic validation

#include "ir/node.oco"
#include "ir/visitor.oco"
#include "data/string.oco"
#include "data/ptr_vector.oco"

// Symbol kinds
const int SYM_VARIABLE = 0;
const int SYM_FUNCTION = 1;
const int SYM_STRUCT = 2;
const int SYM_PROTOCOL = 3;

// Symbol table entry
struct Symbol {
    String name;
    int kind;
    String type;
    int scope;
}

// Symbol table with scope tracking
struct SymbolTable {
    PtrVector symbols;
    int current_scope;
}

// Create a new symbol table
fn sema_new_table() -> SymbolTable {
    SymbolTable st;
    st.symbols = ptr_vector_new(64);
    st.current_scope = 0;
    return st;
}

// Enter a new scope
fn sema_enter_scope(SymbolTable* st) -> void {
    st->current_scope = st->current_scope + 1;
}

// Exit current scope, removing symbols from it
fn sema_exit_scope(SymbolTable* st) -> void {
    int i = ptr_vector_len(st->symbols);
    while (i > 0) {
        i = i - 1;
        Symbol* s = (Symbol*)ptr_vector_at(st->symbols, i);
        if (s->scope == st->current_scope) {
            // In a real implementation we'd remove, but for simplicity mark as out of scope
            // For now, just leave it; lookup checks scope <= current
        }
    }
    st->current_scope = st->current_scope - 1;
}

// Insert a symbol into the table
fn sema_insert(SymbolTable* st, String name, int kind, String type, int scope) -> void {
    Symbol s;
    s.name = name;
    s.kind = kind;
    s.type = type;
    s.scope = scope;
    ptr_vector_push(st->symbols, (void*)s);
}

// Look up a symbol by name, checking current and outer scopes
fn sema_lookup(SymbolTable* st, String name) -> Symbol* {
    int i = ptr_vector_len(st->symbols);
    while (i > 0) {
        i = i - 1;
        Symbol* s = (Symbol*)ptr_vector_at(st->symbols, i);
        if (string_equal(s->name, name)) {
            return s;
        }
    }
    return (Symbol*)0;
}

// Error reporting
fn sema_error(String msg, Node* node) -> void {
    print("Semantic error at ");
    print(node->source_loc);
    print(": ");
    println(msg);
}

// Get type string from a type node (tag 35 = parameter with type child, or direct type tags)
fn sema_get_type_from_node(Node* node) -> String {
    if (node == (Node*)0) {
        return "void";
    }
    // Type nodes: for now, check lexeme or infer from tag
    // Tag 35: Parameter node has type as child[0]
    if (node->tag == 35) {
        if (ptr_vector_len(node->children) > 0) {
            Node* type_node = (Node*)ptr_vector_at(node->children, 0);
            if (type_node != (Node*)0 && type_node->lexeme != (String)0) {
                return type_node->lexeme;
            }
        }
    }
    // For literal nodes, infer type
    if (node->tag == 10) return "int";
    if (node->tag == 21) return "float";
    if (node->tag == 22) return "string";
    if (node->tag == 23) return "char";
    if (node->tag == 24) return "bool";
    // Check lexeme for type names
    if (node->lexeme != (String)0) {
        return node->lexeme;
    }
    return "unknown";
}

// Check if two types are compatible
fn sema_types_compatible(String t1, String t2) -> bool {
    if (string_equal(t1, t2)) return true;
    if (string_equal(t1, "int") && string_equal(t2, "int")) return true;
    if (string_equal(t1, "bool") && string_equal(t2, "bool")) return true;
    if (string_equal(t1, "float") && string_equal(t2, "float")) return true;
    if (string_equal(t1, "void") || string_equal(t2, "void")) return false;
    // Allow int to float promotion
    if (string_equal(t1, "int") && string_equal(t2, "float")) return true;
    if (string_equal(t1, "float") && string_equal(t2, "int")) return true;
    return false;
}

// Forward declarations
fn sema_check_expr(SymbolTable* st, Node* node) -> String;
fn sema_check_stmt(SymbolTable* st, Node* node) -> void;

// Check binary expression (add, sub, mul, div, compare)
fn sema_check_binary(SymbolTable* st, Node* node, int op_tag) -> String {
    if (ptr_vector_len(node->children) < 2) {
        sema_error("binary expression needs two operands", node);
        return "error";
    }
    Node* lhs = (Node*)ptr_vector_at(node->children, 0);
    Node* rhs = (Node*)ptr_vector_at(node->children, 1);
    String lt = sema_check_expr(st, lhs);
    String rt = sema_check_expr(st, rhs);
    
    if (op_tag == 13 || op_tag == 17 || op_tag == 18 || op_tag == 19) {
        // Arithmetic: int+int->int, float+float->float
        if (string_equal(lt, "int") && string_equal(rt, "int")) return "int";
        if (string_equal(lt, "float") && string_equal(rt, "float")) return "float";
        sema_error("type mismatch in arithmetic operation", node);
        return "error";
    }
    if (op_tag == 28) {
        // Comparison: returns bool
        if (!sema_types_compatible(lt, rt)) {
            sema_error("comparison type mismatch", node);
        }
        return "bool";
    }
    if (op_tag == 29) {
        // Logical: returns bool
        if (!string_equal(lt, "bool") || !string_equal(rt, "bool")) {
            sema_error("logical op requires bool operands", node);
        }
        return "bool";
    }
    return "error";
}

// Check an expression node, return its type
fn sema_check_expr(SymbolTable* st, Node* node) -> String {
    if (node == (Node*)0) return "void";
    
    if (node->tag == 10) return "int";       // Integer literal
    if (node->tag == 21) return "float";     // Float literal
    if (node->tag == 22) return "string";    // String literal
    if (node->tag == 23) return "char";      // Char literal
    if (node->tag == 24) return "bool";      // Bool literal
    
    if (node->tag == 11) {
        // Identifier - look up in symbol table
        Symbol* s = sema_lookup(st, node->lexeme);
        if (s == (Symbol*)0) {
            sema_error("undefined identifier: ", node);
            print(node->lexeme);
            println("");
            return "error";
        }
        return s->type;
    }
    
    if (node->tag == 13) return sema_check_binary(st, node, 13);  // Add
    if (node->tag == 17) return sema_check_binary(st, node, 17);  // Multiply
    if (node->tag == 18) return sema_check_binary(st, node, 18);  // Divide
    if (node->tag == 19) return sema_check_binary(st, node, 19);  // Subtract
    if (node->tag == 28) return sema_check_binary(st, node, 28);  // Compare
    if (node->tag == 29) return sema_check_binary(st, node, 29);  // Logical
    
    if (node->tag == 15) {
        // Function call
        String fname = node->lexeme;
        Symbol* s = sema_lookup(st, fname);
        if (s == (Symbol*)0) {
            sema_error("undefined function: ", node);
            print(fname);
            println("");
            return "error";
        }
        if (s->kind != SYM_FUNCTION) {
            sema_error("not a function: ", node);
            print(fname);
            println("");
            return "error";
        }
        // Check argument count (simplified - just check args exist)
        Node* args_node = (Node*)0;
        if (ptr_vector_len(node->children) > 0) {
            args_node = (Node*)ptr_vector_at(node->children, 0);
        }
        // For now, just return the function's return type
        return s->type;
    }
    
    if (node->tag == 40) {
        // Struct field access - simplified
        if (ptr_vector_len(node->children) > 0) {
            Node* expr = (Node*)ptr_vector_at(node->children, 0);
            return sema_check_expr(st, expr);
        }
        return "error";
    }
    
    if (node->tag == 41) {
        // Array index
        if (ptr_vector_len(node->children) > 0) {
            Node* arr = (Node*)ptr_vector_at(node->children, 0);
            return sema_check_expr(st, arr);
        }
        return "error";
    }
    
    // Default: unknown expression type
    return "unknown";
}

// Check a statement node
fn sema_check_stmt(SymbolTable* st, Node* node) -> void {
    if (node == (Node*)0) return;
    
    if (node->tag == 20) {
        // Block statement
        sema_enter_scope(st);
        int i = 0;
        int len = ptr_vector_len(node->children);
        while (i < len) {
            Node* child = (Node*)ptr_vector_at(node->children, i);
            sema_check_stmt(st, child);
            i = i + 1;
        }
        sema_exit_scope(st);
        return;
    }
    
    if (node->tag == 50) {
        // Variable declaration: lexeme=name, children=[type, init]
        String name = node->lexeme;
        String decl_type = "unknown";
        String init_type = "void";
        
        if (ptr_vector_len(node->children) > 0) {
            Node* type_node = (Node*)ptr_vector_at(node->children, 0);
            decl_type = sema_get_type_from_node(type_node);
        }
        if (ptr_vector_len(node->children) > 1) {
            Node* init_node = (Node*)ptr_vector_at(node->children, 1);
            init_type = sema_check_expr(st, init_node);
        }
        
        // Check type compatibility if there's an initializer
        if (!string_equal(init_type, "void") && !string_equal(init_type, "unknown")) {
            if (!sema_types_compatible(decl_type, init_type)) {
                sema_error("type mismatch in variable declaration", node);
            }
        }
        
        // Insert into symbol table
        sema_insert(st, name, SYM_VARIABLE, decl_type, st->current_scope);
        return;
    }
    
    if (node->tag == 14) {
        // Assignment: children=[lhs, rhs]
        if (ptr_vector_len(node->children) < 2) {
            sema_error("assignment needs lhs and rhs", node);
            return;
        }
        Node* lhs = (Node*)ptr_vector_at(node->children, 0);
        Node* rhs = (Node*)ptr_vector_at(node->children, 1);
        String lt = sema_check_expr(st, lhs);
        String rt = sema_check_expr(st, rhs);
        if (!sema_types_compatible(lt, rt)) {
            sema_error("assignment type mismatch", node);
        }
        return;
    }
    
    if (node->tag == 25) {
        // If statement: children=[cond, then, else]
        if (ptr_vector_len(node->children) > 0) {
            Node* cond = (Node*)ptr_vector_at(node->children, 0);
            String ct = sema_check_expr(st, cond);
            if (!string_equal(ct, "bool") && !string_equal(ct, "error")) {
                sema_error("if condition must be bool", node);
            }
        }
        if (ptr_vector_len(node->children) > 1) {
            Node* then_body = (Node*)ptr_vector_at(node->children, 1);
            sema_check_stmt(st, then_body);
        }
        if (ptr_vector_len(node->children) > 2) {
            Node* else_body = (Node*)ptr_vector_at(node->children, 2);
            sema_check_stmt(st, else_body);
        }
        return;
    }
    
    if (node->tag == 26) {
        // While loop: children=[cond, body]
        if (ptr_vector_len(node->children) > 0) {
            Node* cond = (Node*)ptr_vector_at(node->children, 0);
            String ct = sema_check_expr(st, cond);
            if (!string_equal(ct, "bool") && !string_equal(ct, "error")) {
                sema_error("while condition must be bool", node);
            }
        }
        if (ptr_vector_len(node->children) > 1) {
            Node* body = (Node*)ptr_vector_at(node->children, 1);
            sema_check_stmt(st, body);
        }
        return;
    }
    
    if (node->tag == 27) {
        // Return: children=[expr]
        if (ptr_vector_len(node->children) > 0) {
            Node* expr = (Node*)ptr_vector_at(node->children, 0);
            sema_check_expr(st, expr);
        }
        return;
    }
    
    if (node->tag == 15) {
        // Function call as statement
        sema_check_expr(st, node);
        return;
    }
    
    // For other nodes, try as expression
    sema_check_expr(st, node);
}

// Check a function definition
fn sema_check_function(SymbolTable* st, Node* node) -> void {
    // node tag 1: Function, lexeme=name, children=[type, params, body]
    String name = node->lexeme;
    String ret_type = "void";
    
    if (ptr_vector_len(node->children) > 0) {
        Node* type_node = (Node*)ptr_vector_at(node->children, 0);
        ret_type = sema_get_type_from_node(type_node);
    }
    
    // Insert function into symbol table before checking body (for recursion)
    sema_insert(st, name, SYM_FUNCTION, ret_type, 0);
    
    // Enter function scope
    sema_enter_scope(st);
    
    // Process parameters
    if (ptr_vector_len(node->children) > 1) {
        Node* params_node = (Node*)ptr_vector_at(node->children, 1);
        int i = 0;
        int plen = ptr_vector_len(params_node->children);
        while (i < plen) {
            Node* param = (Node*)ptr_vector_at(params_node->children, i);
            if (param->tag == 35) {
                String pname = param->lexeme;
                String ptype = "unknown";
                if (ptr_vector_len(param->children) > 0) {
                    Node* ptype_node = (Node*)ptr_vector_at(param->children, 0);
                    ptype = sema_get_type_from_node(ptype_node);
                }
                sema_insert(st, pname, SYM_VARIABLE, ptype, st->current_scope);
            }
            i = i + 1;
        }
    }
    
    // Check function body
    if (ptr_vector_len(node->children) > 2) {
        Node* body = (Node*)ptr_vector_at(node->children, 2);
        sema_check_stmt(st, body);
    }
    
    sema_exit_scope(st);
}

// Check a struct definition (basic)
fn sema_check_struct(SymbolTable* st, Node* node) -> void {
    String name = node->lexeme;
    sema_insert(st, name, SYM_STRUCT, name, 0);
    // TODO: check fields
}

// Check a protocol definition (basic)
fn sema_check_protocol(SymbolTable* st, Node* node) -> void {
    String name = node->lexeme;
    sema_insert(st, name, SYM_PROTOCOL, name, 0);
    // TODO: check states and transitions
}

// Check extern C block (basic)
fn sema_check_extern_c(SymbolTable* st, Node* node) -> void {
    // Extern declarations - just register function names
    int i = 0;
    int len = ptr_vector_len(node->children);
    while (i < len) {
        Node* child = (Node*)ptr_vector_at(node->children, i);
        if (child->tag == 1) {
            // Function declaration
            String name = child->lexeme;
            String ret_type = "void";
            if (ptr_vector_len(child->children) > 0) {
                Node* type_node = (Node*)ptr_vector_at(child->children, 0);
                ret_type = sema_get_type_from_node(type_node);
            }
            sema_insert(st, name, SYM_FUNCTION, ret_type, 0);
        }
        i = i + 1;
    }
}

// Main entry point: check an entire program
// node tag 0: Program, children are declarations
fn sema_check_program(SymbolTable* st, Node* program) -> void {
    if (program->tag != 0) {
        sema_error("expected program node", program);
        return;
    }
    
    int i = 0;
    int len = ptr_vector_len(program->children);
    while (i < len) {
        Node* decl = (Node*)ptr_vector_at(program->children, i);
        
        if (decl->tag == 1) {
            sema_check_function(st, decl);
        } else if (decl->tag == 30) {
            sema_check_struct(st, decl);
        } else if (decl->tag == 31) {
            sema_check_protocol(st, decl);
        } else if (decl->tag == 37) {
            sema_check_extern_c(st, decl);
        } else if (decl->tag == 2) {
            // Global variable
            String name = decl->lexeme;
            String gtype = "unknown";
            if (ptr_vector_len(decl->children) > 0) {
                Node* type_node = (Node*)ptr_vector_at(decl->children, 0);
                gtype = sema_get_type_from_node(type_node);
            }
            sema_insert(st, name, SYM_VARIABLE, gtype, 0);
        }
        
        i = i + 1;
    }
}
