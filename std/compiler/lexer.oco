// std/compiler/lexer.oco - Lexer for self-hosted OptiCo compiler

struct Token {
    int tag;
    String lexeme;
    int line;
}

struct Lexer {
    String input;
    int pos;
}

char lexer_peek(Lexer l) {
    if (l.pos >= l.input.len) {
        ' '
    } else {
        string_at(l.input, l.pos)
    }
}

char lexer_advance(Lexer l) {
    {
        char c = lexer_peek(l);
        if (l.pos < l.input.len) {
            l.pos := l.pos + 1;
        }
        c
    }
}

void lexer_skip_whitespace(Lexer l) {
    {
        char c = lexer_peek(l);
        if (c == ' ') {
            {
                lexer_advance(l);
                lexer_skip_whitespace(l);
            }
        } else {
            0
        }
    }
}

Token lexer_next_token(Lexer l) {
    {
        lexer_skip_whitespace(l);
        char c = lexer_advance(l);
        if (l.pos > l.input.len) {
            alloc<Token>(0, alloc<String>(0, alloc<char, Normal>(1)), 0)
        } else {
            if (is_digit(c)) {
                alloc<Token>(10, alloc<String>(1, alloc<char, Normal>(1)), 0)
            } else {
                if (is_alpha(c)) {
                    alloc<Token>(11, alloc<String>(1, alloc<char, Normal>(1)), 0)
                } else {
                    alloc<Token>(1, alloc<String>(1, alloc<char, Normal>(1)), 0)
                }
            }
        }
    }
}
