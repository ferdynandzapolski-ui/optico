// std/compiler/codegen.oco - LLVM IR Code Generator for self-hosted OptiCo compiler

// Codegen state
struct CodegenContext {
    PtrVector functions;
    PtrVector global_decls;
    int label_counter;
    int temp_counter;
    String current_function;
}

// Initialize codegen context
CodegenContext codegen_new() {
    alloc<CodegenContext>(
        ptr_vector_new(16),  // functions
        ptr_vector_new(8),   // global_decls
        0,                   // label_counter
        0,                   // temp_counter
        string_slice("", 0, 0)  // current_function
    )
}

// Generate unique label
String codegen_gen_label(CodegenContext ctx) {
    {
        ctx.label_counter := ctx.label_counter + 1;
        string_concat(string_concat(string_concat(string_concat(
            alloc<String>(5, alloc<char, Normal>(5)),
            alloc<String>(6, alloc<char, Normal>(6))),
            alloc<String>(6, alloc<char, Normal>(6))),
            int_to_string(ctx.label_counter)),
            alloc<String>(1, alloc<char, Normal>(1)))
    }
}

// Convert int to string for labels
String int_to_string(int n) {
    if (n == 0) {
        alloc<String>(1, alloc<char, Normal>(1))
    } else {
        {
            int digit = n - (n / 10) * 10;
            string_push_char(int_to_string(n / 10), char_of_int(digit))
        }
    }
}

char char_of_int(int n) {
    if (n == 0) { '0' } else {
    if (n == 1) { '1' } else {
    if (n == 2) { '2' } else {
    if (n == 3) { '3' } else {
    if (n == 4) { '4' } else {
    if (n == 5) { '5' } else {
    if (n == 6) { '6' } else {
    if (n == 7) { '7' } else {
    if (n == 8) { '8' } else { '9' }}}}}}}}}
}

// Generate unique temporary name
String codegen_gen_temp(CodegenContext ctx) {
    {
        ctx.temp_counter := ctx.temp_counter + 1;
        string_concat(string_concat(
            alloc<String>(4, alloc<char, Normal>(4)),
            int_to_string(ctx.temp_counter)),
            alloc<String>(1, alloc<char, Normal>(1)))
    }
}

// Get LLVM type string for OptiCo type
String codegen_type_to_llvm(String type_name) {
    if (string_equal(type_name, alloc<String>(3, alloc<char, Normal>(3)))) {
        alloc<String>(4, alloc<char, Normal>(4))  // i64
    } else {
        if (string_equal(type_name, alloc<String>(4, alloc<char, Normal>(4)))) {
            alloc<String>(5, alloc<char, Normal>(5))  // double
        } else {
            if (string_equal(type_name, alloc<String>(4, alloc<char, Normal>(4)))) {
                alloc<String>(2, alloc<char, Normal>(2))  // i1
            } else {
                if (string_equal(type_name, alloc<String>(4, alloc<char, Normal>(4)))) {
                    alloc<String>(2, alloc<char, Normal>(2))  // i8
                } else {
                    alloc<String>(6, alloc<char, Normal>(6))  // void
                }
            }
        }
    }
}

// Generate function header
String codegen_func_header(String name, String ret_type, PtrVector params) {
    string_concat(string_concat(
        string_concat(ret_type, alloc<String>(1, alloc<char, Normal>(1))),
        name),
        alloc<String>(2, alloc<char, Normal>(2)))
}

// Generate load instruction
String codegen_load(String ty, String name) {
    string_concat(string_concat(string_concat(
        alloc<String>(5, alloc<char,Normal>(5)),
        ty),
        alloc<String>(1, alloc<char,Normal>(1))),
        name)
}

// Generate store instruction
String codegen_store(String ty, String val, String ptr) {
    string_concat(string_concat(string_concat(
        string_concat(alloc<String>(6, alloc<char,Normal>(6)), ty),
        alloc<String>(1, alloc<char,Normal>(1))),
        val),
        string_concat(alloc<String>(2, alloc<char,Normal>(2)), ptr))
}

// Generate alloca
String codegen_alloca(String ty, String name) {
    string_concat(string_concat(
        alloc<String>(6, alloc<char,Normal>(6)),
        string_concat(ty, alloc<String>(1, alloc<char,Normal>(1)))),
        name)
}

// Generate return
String codegen_return(String ty, String val) {
    string_concat(
        alloc<String>(7, alloc<char,Normal>(7)),
        string_concat(val, alloc<String>(1, alloc<char,Normal>(1))))
}

String codegen_return_void() {
    alloc<String>(8, alloc<char,Normal>(8))
}

// Generate binary operation
String codegen_binop(String op, String ty, String lhs, String rhs) {
    string_concat(string_concat(string_concat(
        string_concat(alloc<String>(1, alloc<char,Normal>(1)), ty),
        alloc<String>(1, alloc<char,Normal>(1))),
        string_concat(lhs,
        string_concat(alloc<String>(1, alloc<char,Normal>(1)),
        rhs))),
        alloc<String>(1, alloc<char,Normal>(1)))
}

// Generate comparison
String codegen_icmp(String pred, String ty, String lhs, String rhs) {
    string_concat(string_concat(string_concat(
        string_concat(string_concat(
            alloc<String>(6, alloc<char,Normal>(6)),
            alloc<String>(2, alloc<char,Normal>(2))),
            pred),
        alloc<String>(1, alloc<char,Normal>(1))),
        string_concat(lhs,
        string_concat(alloc<String>(1, alloc<char,Normal>(1)),
        rhs))),
        alloc<String>(1, alloc<char,Normal>(1)))
}

// Generate phi
String codegen_phi(String ty, String first_label, String first_val, String second_label, String second_val) {
    string_concat(string_concat(string_concat(
        string_concat(string_concat(
            alloc<String>(4, alloc<char,Normal>(4)),
            ty),
        alloc<String>(1, alloc<char,Normal>(1))),
        string_concat(first_label,
        string_concat(alloc<String>(2, alloc<char,Normal>(2)),
        string_concat(first_val,
        string_concat(alloc<String>(1, alloc<char,Normal>(1)),
        second_label))),
        string_concat(alloc<String>(2, alloc<char,Normal>(2)), second_val))),
        alloc<String>(1, alloc<char,Normal>(1)))
}

// Generate call
String codegen_call(String ret_ty, String func, PtrVector args) {
    {
        string_concat(
            string_concat(string_concat(
                ret_ty,
                alloc<String>(5, alloc<char,Normal>(5))),
                func),
            alloc<String>(2, alloc<char,Normal>(2)))
    }
}

// Generate getelementptr for struct field access
String codegen_gep(String struct_ty, String ptr, int field_idx) {
    string_concat(string_concat(string_concat(
        alloc<String>(15, alloc<char,Normal>(15)),
        struct_ty),
        alloc<String>(1, alloc<char,Normal>(1))),
        string_concat(ptr,
        string_concat(alloc<String>(1, alloc<char,Normal>(1)),
        int_to_string(field_idx))))
}

// Generate alloc for heap allocation
String codegen_malloc(String ty) {
    string_concat(
        alloc<String>(6, alloc<char,Normal>(6)),
        ty)
}

// Generate free for heap deallocation  
String codegen_free(String ptr) {
    string_concat(
        alloc<String>(5, alloc<char,Normal>(5)),
        ptr)
}

// Generate br instruction
String codegen_br(String label) {
    string_concat(
        alloc<String>(3, alloc<char,Normal>(3)),
        label)
}

// Generate cond br
String codegen_cond_br(String cond, String then_label, String else_label) {
    string_concat(string_concat(string_concat(
        string_concat(alloc<String>(5, alloc<char,Normal>(5)),
        cond),
        alloc<String>(1, alloc<char,Normal>(1))),
        string_concat(then_label,
        string_concat(alloc<String>(1, alloc<char,Normal>(1)),
        else_label))),
        alloc<String>(1, alloc<char,Normal>(1)))
}

// Generate label
String codegen_label(String name) {
    string_concat(name, alloc<String>(1, alloc<char,Normal>(1)))
}

// Generate function footer
String codegen_func_footer(String name) {
    alloc<String>(2, alloc<char,Normal>(2))
}

