// std/compiler/parser.oco - Parser for self-hosted OptiCo v0.3 compiler

struct Parser {
    Lexer lexer;
    Token current;
}

void parser_advance(Parser p) {
    p.current := lexer_next_token(p.lexer);
}

Node* parser_parse_primary(Parser p) {
    {
        if (p.current.tag == 20) { // Number
            {
                String lex = p.current.lexeme;
                parser_advance(p);
                alloc<Node>(10, 0, lex, ptr_vector_new(0))
            }
        } else {
            if (p.current.tag == 21) { // Ident
                {
                    String lex = p.current.lexeme;
                    parser_advance(p);
                    alloc<Node>(11, 0, lex, ptr_vector_new(0))
                }
            } else {
                if (p.current.tag == 3) { // LParen
                    {
                        parser_advance(p);
                        Node* e = parser_parse_expr(p);
                        if (p.current.tag == 4) { // RParen
                            parser_advance(p);
                        } else { 0 };
                        e
                    }
                } else {
                    alloc<Node>(99, 0, alloc<String>(0, alloc<char, Normal>(0)), ptr_vector_new(0))
                }
            }
        }
    }
}

Node* parser_parse_postfix(Parser p) {
    {
        Node* e = parser_parse_primary(p);
        if (p.current.tag == 12) { // Arrow
            {
                parser_advance(p);
                String field = p.current.lexeme;
                parser_advance(p);
                PtrVector children = ptr_vector_new(1);
                ptr_vector_push(children, e);
                alloc<Node>(12, 0, field, children)
            }
        } else {
            e
        }
    }
}

Node* parser_parse_expr(Parser p) {
    {
        Node* e = parser_parse_postfix(p);
        if (p.current.tag == 11) { // Plus
            {
                parser_advance(p);
                Node* right = parser_parse_expr(p);
                PtrVector children = ptr_vector_new(2);
                ptr_vector_push(children, e);
                ptr_vector_push(children, right);
                alloc<Node>(13, 0, alloc<String>(1, alloc<char, Normal>(1)), children)
            }
        } else {
            e
        }
    }
}

Node* parser_parse_stmt(Parser p) {
    {
        Node* e = parser_parse_expr(p);
        if (p.current.tag == 7) { // Semi
            parser_advance(p);
        } else { 0 };
        e
    }
}

Node* parser_parse_struct(Parser p) {
    {
        parser_advance(p); // struct
        String name = p.current.lexeme;
        parser_advance(p); // name
        if (p.current.tag == 1) { // {
            {
                parser_advance(p);
                // simplified: skip fields until }
                parser_skip_until_brace(p);
                alloc<Node>(20, 0, name, ptr_vector_new(0))
            }
        } else {
            alloc<Node>(99, 0, name, ptr_vector_new(0))
        }
    }
}

void parser_skip_until_brace(Parser p) {
    parser_skip_until_brace_rec(p, 1)
}

void parser_skip_until_brace_rec(Parser p, int depth) {
    if (depth == 0) {
        0
    } else {
        {
            if (p.current.tag == 1) { // {
                {
                    parser_advance(p);
                    parser_skip_until_brace_rec(p, depth + 1);
                }
            } else {
                if (p.current.tag == 2) { // }
                    {
                        parser_advance(p);
                        parser_skip_until_brace_rec(p, depth - 1);
                    }
                } else {
                    if (p.current.tag == 0) { // EOF
                        0
                    } else {
                        {
                            parser_advance(p);
                            parser_skip_until_brace_rec(p, depth);
                        }
                    }
                }
            }
        }
    }
}

Node* parser_parse_decl(Parser p) {
    {
        if (p.current.tag == 21) { // Type name (simplified)
            {
                String ty = p.current.lexeme;
                // Check if it is 'struct'
                if (string_equal(ty, alloc<String>(6, "struct"))) {
                    parser_parse_struct(p)
                } else {
                    {
                        parser_advance(p);
                        String name = p.current.lexeme;
                        parser_advance(p);
                        if (p.current.tag == 3) { // Function LParen
                            {
                                parser_advance(p); // (
                                parser_advance(p); // )
                                Node* body = parser_parse_primary(p);
                                PtrVector children = ptr_vector_new(1);
                                ptr_vector_push(children, body);
                                alloc<Node>(1, 0, name, children)
                            }
                        } else {
                            alloc<Node>(2, 0, name, ptr_vector_new(0))
                        }
                    }
                }
            }
        } else {
            alloc<Node>(99, 0, p.current.lexeme, ptr_vector_new(0))
        }
    }
}
