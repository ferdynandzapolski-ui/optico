// std/compiler/parser.oco - Parser for self-hosted OptiCo v0.3 compiler

struct Parser {
    Lexer lexer;
    Token current;
}

void parser_advance(Parser p) {
    p.current := lexer_next_token(p.lexer);
}

void parser_expect(Parser p, int tag) {
    if (p.current.tag == tag) {
        parser_advance(p)
    } else {
        // Error handling placeholder
        0
    }
}

Node* parser_make_node(int kind, String lexeme, PtrVector children, Parser p) {
    alloc<Node>(0, kind, lexeme, children, 0, 0, p.lexer.source_file, p.lexer.line, node_empty_fingerprint(), 1)
}

Node* parser_parse_type(Parser p) {
    {
        String name = p.current.lexeme;
        int tag = p.current.tag;
        parser_advance(p);

        Node* ty = parser_make_node(5, name, ptr_vector_new(0), p);

        // Handle pointer/optic stars
        if (p.current.tag == 10) { // Star
            {
                parser_advance(p);
                PtrVector children = ptr_vector_new(1);
                ptr_vector_push(children, ty);
                ty := parser_make_node(6, string_slice("*", 0, 1), children, p);
            }
        } else { 0 };

        ty
    }
}

Node* parser_parse_primary(Parser p) {
    {
        if (p.current.tag == 20) { // Number
            {
                String lex = p.current.lexeme;
                parser_advance(p);
                parser_make_node(10, lex, ptr_vector_new(0), p)
            }
        } else {
            if (p.current.tag == 21) { // Ident
                {
                    String lex = p.current.lexeme;
                    parser_advance(p);
                    parser_make_node(11, lex, ptr_vector_new(0), p)
                }
            } else {
                if (p.current.tag == 3) { // LParen
                    {
                        parser_advance(p);
                        Node* e = parser_parse_expr(p);
                        parser_expect(p, 4); // RParen
                        e
                    }
                } else {
                    if (p.current.tag == 1) { // LBrace (Block)
                        {
                            parser_advance(p);
                            PtrVector stmts = ptr_vector_new(4);
                            parser_parse_block_stmts(p, stmts);
                            parser_expect(p, 2); // RBrace
                            parser_make_node(20, string_slice("", 0, 0), stmts, p)
                        }
                    } else {
                        parser_make_node(99, string_slice("", 0, 0), ptr_vector_new(0), p)
                    }
                }
            }
        }
    }
}

void parser_parse_block_stmts(Parser p, PtrVector stmts) {
    if (p.current.tag != 2) { // RBrace
        {
            ptr_vector_push(stmts, parser_parse_expr(p));
            if (p.current.tag == 7) { // Semi
                parser_advance(p);
            } else { 0 };
            parser_parse_block_stmts(p, stmts);
        }
    } else {
        0
    }
}

Node* parser_parse_postfix(Parser p) {
    {
        Node* e = parser_parse_primary(p);
        if (p.current.tag == 12) { // Arrow
            {
                parser_advance(p);
                String field = p.current.lexeme;
                parser_advance(p);
                PtrVector children = ptr_vector_new(1);
                ptr_vector_push(children, e);
                parser_make_node(12, field, children, p)
            }
        } else {
            if (p.current.tag == 3) { // Call LParen
                {
                    parser_advance(p);
                    PtrVector args = ptr_vector_new(4);
                    parser_parse_args(p, args);
                    parser_expect(p, 4); // RParen
                    PtrVector children = ptr_vector_new(2);
                    ptr_vector_push(children, e);

                    Node* args_node = parser_make_node(16, string_slice("args", 0, 4), args, p);
                    ptr_vector_push(children, args_node);
                    parser_make_node(15, string_slice("call", 0, 4), children, p)
                }
            } else {
                e
            }
        }
    }
}

void parser_parse_args(Parser p, PtrVector args) {
    if (p.current.tag != 4) { // RParen
        {
            ptr_vector_push(args, parser_parse_expr(p));
            if (p.current.tag == 8) { // Comma
                {
                    parser_advance(p);
                    parser_parse_args(p, args);
                }
            } else { 0 }
        }
    } else { 0 }
}

Node* parser_parse_expr(Parser p) {
    {
        Node* e = parser_parse_postfix(p);
        if (p.current.tag == 11) { // Plus
            {
                parser_advance(p);
                Node* right = parser_parse_expr(p);
                PtrVector children = ptr_vector_new(2);
                ptr_vector_push(children, e);
                ptr_vector_push(children, right);
                parser_make_node(13, string_slice("+", 0, 1), children, p)
            }
        } else {
            if (p.current.tag == 18) { // Assign
                {
                    parser_advance(p);
                    Node* val = parser_parse_expr(p);
                    PtrVector children = ptr_vector_new(2);
                    ptr_vector_push(children, e);
                    ptr_vector_push(children, val);
                    parser_make_node(14, string_slice("=", 0, 1), children, p)
                }
            } else {
                e
            }
        }
    }
}

void parser_parse_struct_fields(Parser p, PtrVector fields) {
    if (p.current.tag != 2) { // RBrace
        {
            Node* ty = parser_parse_type(p);
            String name = p.current.lexeme;
            parser_advance(p);
            parser_expect(p, 7); // Semi
            PtrVector children = ptr_vector_new(1);
            ptr_vector_push(children, ty);
            ptr_vector_push(fields, parser_make_node(32, name, children, p));
            parser_parse_struct_fields(p, fields);
        }
    } else {
        0
    }
}

Node* parser_parse_struct(Parser p) {
    {
        parser_advance(p); // skip 'struct'
        String name = p.current.lexeme;
        parser_advance(p);
        parser_expect(p, 1); // LBrace
        PtrVector fields = ptr_vector_new(4);
        parser_parse_struct_fields(p, fields);
        parser_expect(p, 2); // RBrace
        parser_make_node(30, name, fields, p)
    }
}

void parser_parse_protocol_states(Parser p, PtrVector states) {
    if (p.current.tag == 38) { // state
        {
            parser_advance(p);
            String name = p.current.lexeme;
            parser_advance(p);
            parser_expect(p, 1); // LBrace
            PtrVector optics = ptr_vector_new(4);
            parser_parse_state_optics(p, optics);
            parser_expect(p, 2); // RBrace
            ptr_vector_push(states, parser_make_node(33, name, optics, p));
            parser_parse_protocol_states(p, states);
        }
    } else {
        0
    }
}

void parser_parse_state_optics(Parser p, PtrVector optics) {
    if (p.current.tag != 2) { // RBrace
        {
            Node* ty = parser_parse_type(p);
            String name = p.current.lexeme;
            parser_advance(p);
            parser_expect(p, 7); // Semi
            PtrVector children = ptr_vector_new(1);
            ptr_vector_push(children, ty);
            ptr_vector_push(optics, parser_make_node(34, name, children, p));
            parser_parse_state_optics(p, optics);
        }
    } else {
        0
    }
}

Node* parser_parse_protocol(Parser p) {
    {
        parser_advance(p); // skip 'protocol'
        String name = p.current.lexeme;
        parser_advance(p);
        parser_expect(p, 1); // LBrace
        PtrVector states = ptr_vector_new(2);
        parser_parse_protocol_states(p, states);
        parser_expect(p, 2); // RBrace
        parser_make_node(31, name, states, p)
    }
}

void parser_parse_params(Parser p, PtrVector params) {
    if (p.current.tag != 4) { // RParen
        {
            Node* ty = parser_parse_type(p);
            String name = p.current.lexeme;
            parser_advance(p);

            PtrVector children = ptr_vector_new(1);
            ptr_vector_push(children, ty);
            ptr_vector_push(params, parser_make_node(35, name, children, p));

            if (p.current.tag == 8) { // Comma
                {
                    parser_advance(p);
                    parser_parse_params(p, params);
                }
            } else { 0 }
        }
    } else { 0 }
}

Node* parser_parse_decl(Parser p) {
    {
        if (p.current.tag == 35) { // struct
            parser_parse_struct(p)
        } else {
            if (p.current.tag == 37) { // protocol
                parser_parse_protocol(p)
            } else {
                // Simplified function/global decl
                {
                    Node* ty = parser_parse_type(p);
                    String name = p.current.lexeme;
                    parser_advance(p);
                    if (p.current.tag == 3) { // Function LParen
                        {
                            parser_advance(p); // (
                            PtrVector params = ptr_vector_new(4);
                            parser_parse_params(p, params);
                            parser_expect(p, 4); // )
                            Node* body = parser_parse_primary(p);
                            PtrVector children = ptr_vector_new(3);
                            ptr_vector_push(children, ty);

                            Node* params_node = parser_make_node(36, string_slice("params", 0, 6), params, p);
                            ptr_vector_push(children, params_node);
                            ptr_vector_push(children, body);
                            parser_make_node(1, name, children, p)
                        }
                    } else {
                        {
                            PtrVector children = ptr_vector_new(1);
                            ptr_vector_push(children, ty);
                            parser_make_node(2, name, children, p)
                        }
                    }
                }
            }
        }
    }
}
