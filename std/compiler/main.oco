// std/compiler/main.oco - Main entry point for self-hosted OptiCo compiler
// This compiler compiles OptiCo source code to LLVM IR

// Import all compiler modules (these would be linked together)
// The actual functions are defined in separate files:
// - lexer.oco: Tokenization
// - parser.oco: AST construction  
// - sema.oco: Semantic analysis
// - codegen.oco: LLVM IR generation

// External function declarations (would be provided by runtime)
// For now, these are stubs that would be linked with C runtime
extern "C" {
    int print_int(int n);
    int print_str(String s);
    String read_file(String path);
    int write_file(String path, String content);
}

// Compiler configuration
struct CompilerConfig {
    String input_file;
    String output_file;
    int emit_llvm;        // 1 = true, 0 = false
    int run_goir;         // 1 = run GOIR passes, 0 = false
    String goir_tier;      // "diag", "hybrid", "cap"
}

CompilerConfig config_default() {
    alloc<CompilerConfig>(
        string_slice("", 0, 0),   // input_file
        string_slice("", 0, 0),   // output_file
        1,                          // emit_llvm (default true)
        0,                          // run_goir (default false)
        string_slice("diag", 0, 4) // goir_tier
    )
}

// Parse command line arguments from a simple array
// Format: ["compiler", "file.oco", "-o", "output.ll", "--goir-tier=diag"]
void config_parse(CompilerConfig cfg, int argc, String* argv) {
    int i = 1;  // Skip program name
    while (i < argc) {
        String arg = argv[i];
        int arg_len = string_len(arg);
        
        if (string_starts_with(arg, string_slice("-o", 0, 2))) {
            if (i + 1 < argc) {
                cfg.output_file := argv[i + 1];
                i := i + 2
            } else {
                i := i + 1
            }
        } else {
            if (string_equal(arg, string_slice("--no-llvm", 0, 9))) {
                cfg.emit_llvm := 0;
                i := i + 1
            } else {
                if (string_starts_with(arg, string_slice("--goir-tier=", 0, 12))) {
                    // Extract tier value
                    cfg.goir_tier := string_slice(arg, 12, string_len(arg) - 12);
                    i := i + 1
                } else {
                    // Assume it's an input file
                    if (cfg.input_file == string_slice("", 0, 0)) {
                        cfg.input_file := arg
                    };
                    i := i + 1
                }
            }
        }
    }
}

// Main compilation pipeline
// Returns 0 on success, non-zero on error
int compile(CompilerConfig cfg) {
    // Check if input file is specified
    if (cfg.input_file == string_slice("", 0, 0)) {
        print_str(string_slice("Usage: optico <file.oco> [-o output.ll] [--goir-tier=<diag|hybrid|cap>]\n", 0, 90));
        return 1
    };
    
    // 1. Read input file
    print_str(string_slice("Reading ", 0, 8));
    print_str(cfg.input_file);
    print_str(string_slice("\n", 0, 1));
    
    String source = read_file(cfg.input_file);
    if (source == string_slice("", 0, 0)) {
        print_str(string_slice("Error: Could not read input file\n", 0, 37));
        return 1
    };
    
    // 2. Lexical analysis
    print_str(string_slice("Lexing...\n", 0, 10));
    Lexer lexer = alloc<Lexer>(source, 0, 1);
    PtrVector tokens = ptr_vector_new(1024);
    lexer_lex_all(lexer, tokens);
    
    // 3. Parsing
    print_str(string_slice("Parsing...\n", 0, 11));
    Parser parser = alloc<Parser>(lexer, lexer_current_token(lexer));
    Node* ast = parser_parse_program(parser);
    
    // 4. Semantic analysis
    print_str(string_slice("Semantic analysis...\n", 0, 21));
    SymbolTable st = sema_new_table();
    sema_check_program(st, ast);
    
    // 5. Code generation (LLVM IR)
    print_str(string_slice("Generating LLVM IR...\n", 0, 23));
    CodegenContext ctx = codegen_new();
    String llvm_ir = codegen_generate(ctx, ast);
    
    // 6. Output
    if (cfg.emit_llvm) {
        if (cfg.output_file == string_slice("", 0, 0)) {
            // Default output: input file with .ll extension
            cfg.output_file := string_concat(
                string_slice(cfg.input_file, 0, string_len(cfg.input_file) - 4),
                string_slice(".ll", 0, 3)
            )
        };
        
        print_str(string_slice("Writing ", 0, 8));
        print_str(cfg.output_file);
        print_str(string_slice("\n", 0, 1));
        
        write_file(cfg.output_file, llvm_ir)
    };
    
    // 7. Optionally run GOIR pipeline (would be external process)
    if (cfg.run_goir) {
        print_str(string_slice("GOIR passes would run here with tier: ", 0, 41));
        print_str(cfg.goir_tier);
        print_str(string_slice("\n", 0, 1))
    };
    
    print_str(string_slice("Compilation successful!\n", 0, 25));
    0  // Success
}

// Helper: lex all tokens
void lexer_lex_all(Lexer l, PtrVector tokens) {
    {
        Token t = lexer_next_token(l);
        if (t.tag != 0) {  // Not EOF
            ptr_vector_push(tokens, t);
            lexer_lex_all(l, tokens)
        } else {
            0
        }
    }
}

// Entry point for standalone compilation
// In a real self-hosted compiler, this would be called from main()
int compile_file(String filename) {
    CompilerConfig cfg = config_default();
    cfg.input_file := filename;
    compile(cfg)
}

// Test function: compile a simple expression
int test_simple() {
    CompilerConfig cfg = config_default();
    cfg.input_file := string_slice("test_minimal.oco", 0, 18);
    compile(cfg)
}

// Main function (for testing the compiler itself)
// When the self-hosted compiler is built as a standalone binary,
// this function would be the entry point
int main(int argc, String* argv) {
    CompilerConfig cfg = config_default();
    config_parse(cfg, argc, argv);
    compile(cfg)
}
