// std/prelude.oco - Standard Prelude for OptiCo v0.3

struct Unit {}

struct Pair {
    int fst;
    int snd;
}

struct OptionInt {
    int tag; // 0 for None, 1 for Some
    int value;
}

struct OptionChar {
    int tag;
    char value;
}

struct OptionBool {
    int tag;
    bool value;
}

struct ResultInt {
    int tag; // 0 for Err, 1 for Ok
    int value;
}

struct ResultVoid {
    int tag;
}

struct String {
    int len;
    pointer<char, Heap> data;
}

struct Token {
    int tag;
    String lexeme;
    int line;
}

struct ASTNode {
    int tag;
    int value;
    rec optic ASTNode* left;
    rec optic ASTNode* right;
}

// Basic optics (placeholders for intrinsic support)
optic int* id(optic int* o) {
    o
}

optic int* left(Pair p) {
    p.fst
}

optic int* right(Pair p) {
    p.snd
}

// Utility functions
int is_some(OptionInt o) {
    o.tag
}

int unwrap(OptionInt o) {
    o.value
}

int is_ok(ResultInt r) {
    r.tag
}

bool is_digit(char c) {
    if (c >= '0') {
        c <= '9'
    } else {
        false
    }
}

bool is_alpha(char c) {
    if (c >= 'a') {
        c <= 'z'
    } else {
        if (c >= 'A') {
            c <= 'Z'
        } else {
            c == '_'
        }
    }
}

bool is_alnum(char c) {
    if (is_alpha(c)) {
        true
    } else {
        is_digit(c)
    }
}

bool is_space(char c) {
    if (c == ' ') {
        true
    } else {
        if (c == '\n') {
            true
        } else {
            if (c == '\r') {
                true
            } else {
                c == '\t'
            }
        }
    }
}

bool is_newline(char c) {
    if (c == '\n') {
        true
    } else {
        c == '\r'
    }
}

bool is_hex_digit(char c) {
    if (is_digit(c)) {
        true
    } else {
        if (c >= 'a') {
            if (c <= 'f') {
                true
            } else {
                false
            }
        } else {
            if (c >= 'A') {
                c <= 'F'
            } else {
                false
            }
        }
    }
}
