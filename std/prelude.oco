// std/prelude.oco - Standard Prelude for OptiCo v0.3

struct Unit {}

struct Pair {
    int fst;
    int snd;
}

struct OptionInt {
    int tag; // 0 for None, 1 for Some
    int value;
}

struct OptionChar {
    int tag;
    char value;
}

struct OptionBool {
    int tag;
    bool value;
}

struct ResultInt {
    int tag; // 0 for Err, 1 for Ok
    int value;
}

struct ResultVoid {
    int tag;
}

struct String {
    int len;
    pointer<char, Heap> data;
}

struct Token {
    int tag;
    String lexeme;
    int line;
}

struct ASTNode {
    int tag;
    int value;
    rec optic ASTNode* left;
    rec optic ASTNode* right;
}

// Basic optics (placeholders for intrinsic support)
optic int* id(optic int* o) {
    o
}

optic int* left(Pair p) {
    p.fst
}

optic int* right(Pair p) {
    p.snd
}

// Utility functions
int is_some(OptionInt o) {
    o.tag
}

int unwrap(OptionInt o) {
    o.value
}

int is_ok(ResultInt r) {
    r.tag
}
