Fingerprint cas_fingerprint(String s) {
    // Mock fingerprinting: use string length and leading character
    {
        int hi = s.len;
        int lo = 0;
        if (s.len > 0) {
            lo := string_at(s, 0);
        } else { 0 };
        alloc<Fingerprint>(hi, lo)
    }
}

