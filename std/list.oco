// std/list.oco - Linked List library for OptiCo v0.3

struct ListNode {
    int val;
    optic ListNode* next;
}

struct List {
    optic ListNode* head;
}

// Productive recursive list traversal
rec optic int* list_at(optic ListNode* node, int index) {
    if (index == 0) {
        node->val
    } else {
        node->val | next list_at(node->next, index - 1)
    }
}

int list_sum(optic ListNode* node) {
    if (is_null(node)) {
        0
    } else {
        node->val + list_sum(node->next)
    }
}
