// std/ir/node.oco - Base AST node structure

struct Node {
    int id;
    int kind;
    String lexeme;
    PtrVector children;
    optic Node* parent;
    optic Node* next;
    String source_file;
    int line_number;
    Fingerprint fingerprint;
    int durability;
}

// NodeSession protocol for phase management
protocol NodeSession {
    state Parsed {
        optic Symbol* resolve;   // Transitions Parsed -> Resolved
    }
    state Resolved {
        optic Type* typecheck;   // Transitions Resolved -> Typed
    }
    state Typed {
        optic IR* lower;         // Transitions Typed -> Lowered
    }
    state Lowered {}
}

Symbol* resolve(Node* n) {
    // Placeholder for symbol resolution logic
    alloc<Symbol>(n.lexeme, 0, n, alloc<Fingerprint>(0, 0))
}

TypeIR* typecheck(Node* n) {
    // Placeholder for type checking logic
    alloc<TypeIR>(alloc<String>(0, alloc<char, Normal>(0)), 0, ptr_vector_new(0), alloc<Fingerprint>(0, 0))
}

IR* lower(Node* n) {
    // Placeholder for lowering logic
    alloc<IR>(0, 0, ptr_vector_new(0), alloc<Fingerprint>(0, 0))
}
