// std/ir/node.oco - Base AST node structure

struct Node {
    int id;
    int kind;
    String lexeme;
    PtrVector children;
    optic Node* parent;
    optic Node* next;
    String source_file;
    int line_number;
    Fingerprint fingerprint;
    int durability;
}

// NodeSession protocol for phase management
protocol NodeSession {
    state Parsed {
        optic Symbol* resolve;   // Transitions Parsed -> Resolved
    }
    state Resolved {
        optic Type* typecheck;   // Transitions Resolved -> Typed
    }
    state Typed {
        optic IR* lower;         // Transitions Typed -> Lowered
    }
    state Lowered {}
}

Symbol* resolve(Node* n) {
    {
        // For self-hosting, we start building a symbol table
        Symbol* s = alloc<Symbol>(n.lexeme, 0, n);
        // Transition: Parsed -> Resolved (simplified)
        s
    }
}

TypeIR* typecheck(Node* n) {
    {
        // Simple type checking: everything is Int or Void for now
        String ty_name = alloc<String>(3, alloc<char, Normal>(3));
        ty_name.data[0] := 'I'; ty_name.data[1] := 'n'; ty_name.data[2] := 't';
        TypeIR* t = alloc<TypeIR>(ty_name, 8, ptr_vector_new(0));
        t
    }
}

IR* lower(Node* n) {
    {
        // Lowering to basic IR opcodes
        IR* ir = alloc<IR>(n.kind, 0, ptr_vector_new(0));
        ir
    }
}
