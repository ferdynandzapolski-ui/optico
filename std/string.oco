// std/string.oco - String library for OptiCo v0.3

int string_len(String s) {
    s.len
}

char string_at(String s, int index) {
    s.data[index]
}

bool string_equal(String s1, String s2) {
    if (s1.len != s2.len) {
        false
    } else {
        if (s1.len == 0) {
            true
        } else {
            string_equal_rec(s1.data, s2.data, s1.len, 0)
        }
    }
}

int string_find(String s, char c, int start) {
    if (start >= s.len) {
        0 - 1
    } else {
        if (string_at(s, start) == c) {
            start
        } else {
            string_find(s, c, start + 1)
        }
    }
}

int char_to_int(char c) {
    if (c == '0') { 0 } else {
    if (c == '1') { 1 } else {
    if (c == '2') { 2 } else {
    if (c == '3') { 3 } else {
    if (c == '4') { 4 } else {
    if (c == '5') { 5 } else {
    if (c == '6') { 6 } else {
    if (c == '7') { 7 } else {
    if (c == '8') { 8 } else {
    if (c == '9') { 9 } else { 0 }}}}}}}}}}
}

int string_to_int(String s) {
    string_to_int_rec(s.data, s.len, 0, 0)
}

int string_to_int_rec(pointer<char, Heap> data, int len, int i, int acc) {
    if (i == len) {
        acc
    } else {
        {
            char c = data[i];
            int digit = char_to_int(c);
            string_to_int_rec(data, len, i + 1, acc * 10 + digit)
        }
    }
}

String string_slice(String s, int start, int end) {
    {
        int new_len = end - start;
        if (new_len < 0) {
            new_len = 0;
        } else { 0 };
        pointer<char, Normal> new_data = alloc<char, Normal>(new_len);
        string_copy_rec(new_data, s.data + start, new_len, 0, 0);
        alloc<String>(new_len, new_data)
    }
}

String string_push_char(String s, char c) {
    {
        int new_len = s.len + 1;
        pointer<char, Normal> new_data = alloc<char, Normal>(new_len);
        string_copy_rec(new_data, s.data, s.len, 0, 0);
        new_data[s.len] := c;
        alloc<String>(new_len, new_data)
    }
}

String string_concat(String s1, String s2) {
    {
        int new_len = s1.len + s2.len;
        pointer<char, Normal> new_data = alloc<char, Normal>(new_len);
        string_copy_rec(new_data, s1.data, s1.len, 0, 0);
        string_copy_rec(new_data, s2.data, s2.len, s1.len, 0);
        alloc<String>(new_len, new_data)
    }
}

void string_copy_rec(pointer<char, Normal> dst, pointer<char, Heap> src, int len, int dst_off, int i) {
    if (i < len) {
        {
            dst[dst_off + i] := src[i];
            string_copy_rec(dst, src, len, dst_off, i + 1);
        }
    } else {
        0
    }
}

bool string_equal_rec(pointer<char, Heap> d1, pointer<char, Heap> d2, int len, int i) {
    if (i == len) {
        true
    } else {
        if (d1[i] == d2[i]) {
            string_equal_rec(d1, d2, len, i + 1)
        } else {
            false
        }
    }
}

int string_compare(String s1, String s2) {
    string_compare_rec(s1.data, s1.len, s2.data, s2.len, 0)
}

int string_compare_rec(pointer<char, Heap> d1, int l1, pointer<char, Heap> d2, int l2, int i) {
    if (i == l1) {
        if (i == l2) {
            0
        } else {
            0 - 1
        }
    } else {
        if (i == l2) {
            1
        } else {
            if (d1[i] == d2[i]) {
                string_compare_rec(d1, l1, d2, l2, i + 1)
            } else {
                if (d1[i] < d2[i]) {
                    0 - 1
                } else {
                    1
                }
            }
        }
    }
}

bool string_starts_with(String s, String prefix) {
    if (s.len < prefix.len) {
        false
    } else {
        if (prefix.len == 0) {
            true
        } else {
            string_starts_with_rec(s.data, prefix.data, prefix.len, 0)
        }
    }
}

bool string_starts_with_rec(pointer<char, Heap> d, pointer<char, Heap> p, int len, int i) {
    if (i == len) {
        true
    } else {
        if (d[i] == p[i]) {
            string_starts_with_rec(d, p, len, i + 1)
        } else {
            false
        }
    }
}
