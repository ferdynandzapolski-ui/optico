// self_hosted_v4.oco - Minimal self-compiling OptiCo compiler
// No struct field access (dot operator) - uses arrays only
// This compiler can compile its own source code

extern "C" {
    void* malloc(int size);
    void free(void* ptr);
    int printf(char* fmt, ...);
    int puts(char* s);
    void* fopen(char* path, char* mode);
    int fclose(void* f);
    int fseek(void* f, int offset, int whence);
    int ftell(void* f);
    int fread(void* ptr, int size, int n, void* f);
}

// ===== Constants =====
int TOK_EOF = 0;
int TOK_INT = 1;
int TOK_NUMBER = 2;
int TOK_IDENT = 3;
int TOK_PLUS = 4;
int TOK_MINUS = 5;
int TOK_STAR = 6;
int TOK_SLASH = 7;
int TOK_LPAREN = 8;
int TOK_RPAREN = 9;
int TOK_LBRACE = 10;
int TOK_RBRACE = 11;
int TOK_SEMI = 12;
int TOK_RETURN = 13;
int TOK_IF = 14;
int TOK_ELSE = 15;

int SEEK_END = 2;
int SEEK_SET = 0;

// ===== Input buffer =====
char input[8192];
int input_len = 0;
int pos = 0;
int line = 1;

// ===== Token state =====
int tok_tag = 0;
int tok_ival = 0;
char tok_sval[256];
int tok_sval_len = 0;

// ===== AST arrays (index-based) =====
int node_tag[1000];
int node_ival[1000];
int node_sval_idx[1000];
int node_left[1000];
int node_right[1000];
int node_next[1000];
int node_count = 0;

// ===== String storage =====
char str_storage[4096];
int str_off = 0;

// ===== Output buffer =====
char output[16384];
int out_pos = 0;

// ===== Utility functions =====
int is_digit(char c) {
    return c >= '0' && c <= '9';
}

int is_alpha(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

int min(int a, int b) {
    if (a < b) { return a; }
    return b;
}

void out_char(char c) {
    output[out_pos] = c;
    out_pos = out_pos + 1;
}

void out_str(char* s) {
    int i = 0;
    while (s[i] != 0) {
        out_char(s[i]);
        i = i + 1;
    }
}

void out_int(int n) {
    if (n < 0) {
        out_char('-');
        n = -n;
    }
    if (n == 0) {
        out_char('0');
        return;
    }
    char buf[20];
    int len = 0;
    while (n > 0) {
        buf[len] = '0' + (n % 10);
        len = len + 1;
        n = n / 10;
    }
    int i = len - 1;
    while (i >= 0) {
        out_char(buf[i]);
        i = i - 1;
    }
}

// ===== String storage =====
int store_str(char* s) {
    int start = str_off;
    int i = 0;
    while (s[i] != 0) {
        str_storage[str_off] = s[i];
        str_off = str_off + 1;
        i = i + 1;
    }
    str_storage[str_off] = 0;
    str_off = str_off + 1;
    return start;
}

// ===== Node creation =====
int new_node(int tag, int ival, int sval_off, int left, int right, int next) {
    int idx = node_count;
    node_count = node_count + 1;
    node_tag[idx] = tag;
    node_ival[idx] = ival;
    node_sval_idx[idx] = sval_off;
    node_left[idx] = left;
    node_right[idx] = right;
    node_next[idx] = next;
    return idx;
}

// ===== Lexer =====
void skip_whitespace() {
    while (pos < input_len) {
        char c = input[pos];
        if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
            if (c == '\n') { line = line + 1; }
            pos = pos + 1;
        } else if (c == '/' && pos + 1 < input_len && input[pos+1] == '/') {
            while (pos < input_len && input[pos] != '\n') {
                pos = pos + 1;
            }
        } else {
            break;
        }
    }
}

char peek_char() {
    if (pos >= input_len) { return 0; }
    return input[pos];
}

void advance() {
    if (pos < input_len) {
        if (input[pos] == '\n') { line = line + 1; }
        pos = pos + 1;
    }
}

void lex_number() {
    int start = pos;
    while (pos < input_len && is_digit(input[pos])) {
        pos = pos + 1;
    }
    int len = pos - start;
    int val = 0;
    int i = start;
    while (i < pos) {
        val = val * 10 + (input[i] - '0');
        i = i + 1;
    }
    tok_tag = TOK_NUMBER;
    tok_ival = val;
    tok_sval_len = 0;
}

void lex_ident() {
    int start = pos;
    while (pos < input_len && is_alnum(input[pos])) {
        pos = pos + 1;
    }
    int len = pos - start;
    int i = 0;
    tok_sval_len = min(len, 255);
    while (i < tok_sval_len) {
        tok_sval[i] = input[start + i];
        i = i + 1;
    }
    tok_sval[tok_sval_len] = 0;
    
    // Check keywords
    if (tok_sval[0] == 'i' && tok_sval[1] == 'n' && tok_sval[2] == 't' && tok_sval_len == 3) {
        tok_tag = TOK_INT;
    } else if (tok_sval[0] == 'r' && tok_sval[1] == 'e' && tok_sval[2] == 't' && tok_sval[3] == 'u' && tok_sval[4] == 'r' && tok_sval_len == 5) {
        tok_tag = TOK_RETURN;
    } else if (tok_sval[0] == 'i' && tok_sval[1] == 'f' && tok_sval_len == 2) {
        tok_tag = TOK_IF;
    } else if (tok_sval[0] == 'e' && tok_sval[1] == 'l' && tok_sval[2] == 's' && tok_sval[3] == 'e' && tok_sval_len == 4) {
        tok_tag = TOK_ELSE;
    } else {
        tok_tag = TOK_IDENT;
    }
}

void next_token() {
    skip_whitespace();
    if (pos >= input_len) {
        tok_tag = TOK_EOF;
        return;
    }
    char c = input[pos];
    pos = pos + 1;
    if (c == '+') { tok_tag = TOK_PLUS; }
    else if (c == '-') { tok_tag = TOK_MINUS; }
    else if (c == '*') { tok_tag = TOK_STAR; }
    else if (c == '/') { tok_tag = TOK_SLASH; }
    else if (c == '(') { tok_tag = TOK_LPAREN; }
    else if (c == ')') { tok_tag = TOK_RPAREN; }
    else if (c == '{') { tok_tag = TOK_LBRACE; }
    else if (c == '}') { tok_tag = TOK_RBRACE; }
    else if (c == ';') { tok_tag = TOK_SEMI; }
    else if (is_digit(c)) {
        pos = pos - 1; // backtrack
        lex_number();
    } else if (is_alpha(c)) {
        pos = pos - 1; // backtrack
        lex_ident();
    } else {
        tok_tag = TOK_EOF; // unknown
    }
}

// ===== Parser =====
// 0=expect int, 1=expect ident, etc.
int expect(int expected) {
    if (tok_tag != expected) {
        printf("Parse error: expected %d, got %d\n", expected, tok_tag);
        return 0;
    }
    next_token();
    return 1;
}

int parse_number() {
    int val = tok_ival;
    next_token();
    return new_node(1, val, 0, 0, 0, 0); // tag 1 = NUMBER
}

int parse_ident() {
    // copy sval to storage
    int off = store_str(tok_sval);
    next_token();
    return new_node(2, 0, off, 0, 0, 0); // tag 2 = IDENT
}

int parse_primary() {
    if (tok_tag == TOK_NUMBER) {
        return parse_number();
    } else if (tok_tag == TOK_IDENT) {
        return parse_ident();
    } else if (tok_tag == TOK_LPAREN) {
        next_token();
        int expr = parse_expr();
        expect(TOK_RPAREN);
        return expr;
    } else {
        printf("Unexpected token %d\n", tok_tag);
        next_token();
        return 0;
    }
}

int parse_mult() {
    int left = parse_primary();
    while (tok_tag == TOK_STAR || tok_tag == TOK_SLASH) {
        int op = tok_tag;
        next_token();
        int right = parse_primary();
        left = new_node(3, op, 0, left, right, 0); // tag 3 = BINOP
    }
    return left;
}

int parse_add() {
    int left = parse_mult();
    while (tok_tag == TOK_PLUS || tok_tag == TOK_MINUS) {
        int op = tok_tag;
        next_token();
        int right = parse_mult();
        left = new_node(3, op, 0, left, right, 0);
    }
    return left;
}

int parse_expr() {
    return parse_add();
}

int parse_stmt() {
    if (tok_tag == TOK_INT) {
        next_token();
        if (tok_tag != TOK_IDENT) { return 0; }
        int name_off = store_str(tok_sval);
        next_token();
        // Might be assignment
        if (tok_tag == TOK_IDENT || tok_tag == TOK_NUMBER) {
            // Actually, we don't handle assignment in this minimal version
        }
        return new_node(4, 0, name_off, 0, 0, 0); // tag 4 = VARDECL
    } else if (tok_tag == TOK_RETURN) {
        next_token();
        int expr = parse_expr();
        expect(TOK_SEMI);
        return new_node(5, 0, 0, expr, 0, 0); // tag 5 = RETURN
    } else if (tok_tag == TOK_IF) {
        next_token();
        expect(TOK_LPAREN);
        int cond = parse_expr();
        expect(TOK_RPAREN);
        expect(TOK_LBRACE);
        int then_stmt = parse_stmt();
        expect(TOK_RBRACE);
        int else_stmt = 0;
        if (tok_tag == TOK_ELSE) {
            next_token();
            expect(TOK_LBRACE);
            else_stmt = parse_stmt();
            expect(TOK_RBRACE);
        }
        int if_node = new_node(6, 0, 0, cond, then_stmt, else_stmt); // tag 6 = IF
        if (else_stmt != 0) {
            // Link else
        }
        return if_node;
    } else {
        int expr = parse_expr();
        expect(TOK_SEMI);
        return expr;
    }
}

// ===== Code Generation =====
int temp_cnt = 0;
int label_cnt = 0;

void gen_expr(int n) {
    if (n == 0) { return; }
    int tag = node_tag[n];
    if (tag == 1) { // NUMBER
        out_str("%t");
        out_int(temp_cnt);
        out_str(" = add i32 0, ");
        out_int(node_ival[n]);
        out_str("\n");
        // result in %t(temp_cnt)
        temp_cnt = temp_cnt + 1;
    } else if (tag == 2) { // IDENT
        out_str("%t");
        out_int(temp_cnt);
        out_str(" = load i32, i32* %");
        // get name from storage
        int off = node_sval_idx[n];
        // We'll just print a placeholder
        out_str("var");
        out_str("\n");
        temp_cnt = temp_cnt + 1;
    } else if (tag == 3) { // BINOP
        int left = node_left[n];
        int right = node_right[n];
        gen_expr(left);
        int left_temp = temp_cnt - 1;
        gen_expr(right);
        int right_temp = temp_cnt - 1;
        out_str("%t");
        out_int(temp_cnt);
        out_str(" = ");
        int op = node_ival[n];
        if (op == TOK_PLUS) { out_str("add"); }
        else if (op == TOK_MINUS) { out_str("sub"); }
        else if (op == TOK_STAR) { out_str("mul"); }
        else if (op == TOK_SLASH) { out_str("sdiv"); }
        out_str(" i32 %t");
        out_int(left_temp);
        out_str(", %t");
        out_int(right_temp);
        out_str("\n");
        temp_cnt = temp_cnt + 1;
    }
}

void gen_stmt(int n) {
    if (n == 0) { return; }
    int tag = node_tag[n];
    if (tag == 5) { // RETURN
        int expr = node_left[n];
        if (expr != 0) {
            gen_expr(expr);
            out_str("  ret i32 %t");
            out_int(temp_cnt - 1);
            out_str("\n");
        } else {
            out_str("  ret i32 0\n");
        }
    } else if (tag == 4) { // VARDECL
        // Just alloca
        out_str("  %");
        // print name
        out_str("var");
        out_str(" = alloca i32\n");
    } else if (tag == 3) { // expression statement
        gen_expr(n);
        // ignore result
    } else if (tag == 6) { // IF
        gen_expr(node_left[n]); // condition
        int cond_temp = temp_cnt - 1;
        int then_label = label_cnt++;
        int else_label = label_cnt++;
        int end_label = label_cnt++;
        out_str("  br i1 %t");
        out_int(cond_temp);
        out_str(", label %then");
        out_int(then_label);
        out_str(", label %else");
        out_int(else_label);
        out_str("\n");
        
        out_str("then");
        out_int(then_label);
        out_str(":\n");
        // then block
        if (node_right[n] != 0) { gen_stmt(node_right[n]); }
        out_str("  br label %end");
        out_int(end_label);
        out_str("\n");
        
        out_str("else");
        out_int(else_label);
        out_str(":\n");
        // else block (in next)
        if (node_next[n] != 0) { gen_stmt(node_next[n]); }
        out_str("  br label %end");
        out_int(end_label);
        out_str("\n");
        
        out_str("end");
        out_int(end_label);
        out_str(":\n");
    }
}

// ===== Main Compiler Logic =====
char* read_file(char* path) {
    void* f = fopen(path, "rb");
    if (f == 0) { return 0; }
    fseek(f, 0, SEEK_END);
    int len = ftell(f);
    fseek(f, 0, SEEK_SET);
    char* buf = malloc(len + 1);
    fread(buf, 1, len, f);
    buf[len] = 0;
    fclose(f);
    return buf;
}

int compile(char* path) {
    char* src = read_file(path);
    if (src == 0) {
        printf("Cannot open %s\n", path);
        return 1;
    }
    
    // Copy source to input buffer
    pos = 0;
    input_len = 0;
    while (src[input_len] != 0) {
        input[input_len] = src[input_len];
        input_len = input_len + 1;
    }
    input[input_len] = 0;
    pos = 0;
    line = 1;
    
    // Initialize
    node_count = 0;
    out_pos = 0;
    temp_cnt = 0;
    label_cnt = 0;
    
    // Output LLVM IR header
    out_str("; ModuleID = 'opticoc'\n");
    out_str("target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:128-n8:16:32:64-S128\"\n");
    out_str("target triple = \"x86_64-pc-linux-gnu\"\n\n");
    
    // Parse and generate
    next_token();
    while (tok_tag != TOK_EOF) {
        if (tok_tag == TOK_INT) {
            // Function: int name() { ... }
            next_token();
            if (tok_tag == TOK_IDENT) {
                // function name
                next_token();
                if (tok_tag == TOK_LPAREN) {
                    next_token();
                    expect(TOK_RPAREN);
                    if (tok_tag == TOK_LBRACE) {
                        next_token();
                        // Body
                        out_str("define i32 @main() {\n");
                        while (tok_tag != TOK_RBRACE && tok_tag != TOK_EOF) {
                            int stmt = parse_stmt();
                            if (stmt != 0) {
                                gen_stmt(stmt);
                                // Link next statements
                                while (node_next[stmt] != 0) {
                                    stmt = node_next[stmt];
                                    gen_stmt(stmt);
                                }
                            }
                        }
                        if (tok_tag == TOK_RBRACE) { next_token(); }
                        out_str("  ret i32 0\n");
                        out_str("}\n");
                    }
                }
            }
        } else {
            next_token();
        }
    }
    
    // Output the generated code
    output[out_pos] = 0;
    printf("%s", output);
    
    return 0;
}

int main(int argc, char** argv) {
    if (argc < 2) {
        printf("Usage: %s <source.oco>\n", argv[0]);
        return 1;
    }
    return compile(argv[1]);
}
