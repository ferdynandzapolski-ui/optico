// control_flow_test.oco - Test control flow constructs

extern "C" {
    void print_int(int val);
}

// Test while loop
int test_while_loop() {
    int sum = 0;
    int i = 1;

    while (i <= 5) {
        sum = sum + i;
        i = i + 1;
    }

    sum  // Should be 15 (1+2+3+4+5)
}

// Test nested if-else
int test_nested_if(int x) {
    if (x > 10) {
        if (x > 20) {
            100
        } else {
            50
        }
    } else {
        if (x > 5) {
            25
        } else {
            0
        }
    }
}

// Test complex control flow
void test_control_flow() {
    print_int(test_while_loop());    // 15
    print_int(test_nested_if(15));   // 50
    print_int(test_nested_if(7));    // 25
    print_int(test_nested_if(3));    // 0
}