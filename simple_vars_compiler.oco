// simple_vars_compiler.oco - Simple compiler with variables

extern "C" {
    void print_int(int val);
}

// Global state
int input_pos;
int current_val;

// Initialize
void init_parser(char* input) {
    input_pos := 0;
    current_val := 0;
}

// Get digit value
int get_digit(char* input) {
    int d = input[input_pos] - '0';
    input_pos := input_pos + 1;
    d
}

// Parse number
int parse_number(char* input) {
    int val = 0;
    while (input[input_pos] >= '0' && input[input_pos] <= '9') {
        val := val * 10 + get_digit(input);
    }
    val
}

// Parse expression
int parse_expr(char* input) {
    int left = parse_number(input);

    if (input[input_pos] == '+') {
        input_pos := input_pos + 1;
        int right = parse_expr(input);
        left + right
    } else {
        left
    }
}

// Test function with variables
void test_variables() {
    int x = 10;
    int y = 20;
    int sum = x + y;
    print_int(sum);
}

// Main compiler
int compile(char* source) {
    init_parser(source);
    int result = parse_expr(source);
    print_int(result);
    result
}