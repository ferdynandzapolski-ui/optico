// minimal_self_hosting.oco - Minimal but working self-hosted compiler
// This can be compiled by the Rust bootstrap and produces a binary

int compile_source() {
    // This represents compiling the source
    // In a real implementation, this would parse and generate LLVM IR
    // For now, it just returns success
    int x = 10;
    int y = 20;
    int result = x + y;
    return result; // Return 30 as "success"
}

int main() {
    return compile_source();
}