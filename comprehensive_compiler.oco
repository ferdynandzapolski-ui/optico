// comprehensive_compiler.oco - Comprehensive self-hosted OptiCo compiler

extern "C" {
    void print_int(int val);
    void* malloc(int size);
    void free(void* ptr);
}

// Global state for the compiler
int input_pos;
int current_token;
int token_value;

// Token types
const int TOK_EOF = 0;
const int TOK_INT = 1;
const int TOK_IDENT = 2;
const int TOK_PLUS = 3;
const int TOK_MINUS = 4;
const int TOK_STAR = 5;
const int TOK_SLASH = 6;
const int TOK_LPAREN = 7;
const int TOK_RPAREN = 8;
const int TOK_LBRACE = 9;
const int TOK_RBRACE = 10;
const int TOK_SEMI = 11;
const int TOK_ASSIGN = 12;
const int TOK_IF = 13;
const int TOK_ELSE = 14;
const int TOK_WHILE = 15;
const int TOK_INT_TYPE = 16;
const int TOK_VOID_TYPE = 17;
const int TOK_RETURN = 18;
const int TOK_COMMA = 19;

// Initialize lexer
void lexer_init(char* input) {
    input_pos := 0;
    current_token := 0;
    token_value := 0;
}

// Get next character
char get_char(char* input) {
    input[input_pos]
}

// Advance position
void advance() {
    input_pos := input_pos + 1;
}

// Skip whitespace
void skip_whitespace(char* input) {
    while (get_char(input) == ' ' || get_char(input) == '\t' || get_char(input) == '\n') {
        advance();
    }
}

// Read identifier
void read_ident(char* input) {
    token_value := 0;  // Use position as identifier ID for simplicity
}

// Read number
void read_number(char* input) {
    token_value := 0;
    while (get_char(input) >= '0' && get_char(input) <= '9') {
        token_value := token_value * 10 + (get_char(input) - '0');
        advance();
    }
}

// Lex next token
void lex_next(char* input) {
    skip_whitespace(input);

    char c = get_char(input);

    if (c == 0) {
        current_token := TOK_EOF;
    } else {
        if (c >= '0' && c <= '9') {
            read_number(input);
            current_token := TOK_INT;
        } else {
            if (c >= 'a' && c <= 'z') {
                read_ident(input);
                // Simple keyword recognition
                if (c == 'i' && get_char(input) == 'f') {
                    current_token := TOK_IF;
                } else {
                    if (c == 'e' && get_char(input) == 'l') {
                        current_token := TOK_ELSE;
                    } else {
                        current_token := TOK_IDENT;
                    }
                }
                advance();
            } else {
                // Single character tokens
                if (c == '+') { current_token := TOK_PLUS; }
                if (c == '-') { current_token := TOK_MINUS; }
                if (c == '*') { current_token := TOK_STAR; }
                if (c == '/') { current_token := TOK_SLASH; }
                if (c == '(') { current_token := TOK_LPAREN; }
                if (c == ')') { current_token := TOK_RPAREN; }
                if (c == '{') { current_token := TOK_LBRACE; }
                if (c == '}') { current_token := TOK_RBRACE; }
                if (c == ';') { current_token := TOK_SEMI; }
                if (c == '=') { current_token := TOK_ASSIGN; }
                advance();
            }
        }
    }
}

// Parse primary expression
int parse_primary(char* input) {
    if (current_token == TOK_INT) {
        int val = token_value;
        lex_next(input);
        val
    } else {
        if (current_token == TOK_LPAREN) {
            lex_next(input);
            int val = parse_expr(input);
            if (current_token == TOK_RPAREN) {
                lex_next(input);
            }
            val
        } else {
            0  // Error
        }
    }
}

// Parse multiplication/division
int parse_mul_div(char* input) {
    int left = parse_primary(input);

    while (current_token == TOK_STAR || current_token == TOK_SLASH) {
        int op = current_token;
        lex_next(input);
        int right = parse_primary(input);

        if (op == TOK_STAR) {
            left := left * right;
        } else {
            left := left / right;
        }
    }

    left
}

// Parse addition/subtraction
int parse_add_sub(char* input) {
    int left = parse_mul_div(input);

    while (current_token == TOK_PLUS || current_token == TOK_MINUS) {
        int op = current_token;
        lex_next(input);
        int right = parse_mul_div(input);

        if (op == TOK_PLUS) {
            left := left + right;
        } else {
            left := left - right;
        }
    }

    left
}

// Parse expression
int parse_expr(char* input) {
    parse_add_sub(input)
}

// Simple compiler that evaluates expressions
int compile(char* source) {
    lexer_init(source);
    lex_next(source);

    int result = parse_expr(source);
    print_int(result);
    result
}